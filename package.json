{
  "name": "formcoach",
  "productName": "FormCoach",
  "version": "1.0.1",
  "private": true,
  "description": "Real-time workout form feedback that runs entirely on your computer",
  "author": "David Kaminsky",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "setup": "node scripts/setup-assets.mjs",
    "dev": "vite --open",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --open",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "app": "npm run build && electron .",
    "package": "npm run build && electron-builder --win nsis && node scripts/clean-release.mjs"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "@types/node": "^26.6.5",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "app.formcoach.desktop",
    "productName": "FormCoach",
    "copyright": "Copyright (c) 2026 David Kaminsky",
    "directories": {
      "output": "installer",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/wasm/vision_wasm_module_internal.*",
      "!dist/wasm/vision_wasm_nosimd_internal.*",
      "electron/**/*",
      "package.json"
    ],
    "compression": "maximum",
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": ["en-US"],
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FormCoach",
      "uninstallDisplayName": "FormCoach",
      "artifactName": "FormCoach-Setup-${version}.${ext}"
    }
  }
}
